# MAD Studio API
# Copy to .env and adjust. Every variable is validated at boot (src/config/env.ts).

NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# Comma-separated list of allowed browser origins. Sessions are cookies, so this
# list must be explicit (never "*"); in development any loopback origin also passes.
CORS_ORIGINS=http://localhost:4200,https://studio.madproducts.ai

# Leave empty to run with the in-memory repository (schema-identical mirror of PostgreSQL).
DATABASE_URL=postgres://mad:mad@localhost:5432/mad_studio

# Multiplies every generation stream delay. 1 = designed pacing, 0 = instant (tests).
GENERATION_PACE=1

# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Authentication ---------------------------------------------------------
# Sliding session lifetime for the HttpOnly `mad_session` cookie.
SESSION_TTL_DAYS=30
# Optional: give the seeded demo account (id 00000000-0000-4000-8000-000000000001)
# an email and password so its owner can sign in. Re-run `npm run db:seed` after
# changing either; the in-memory repository reads them at boot.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Model-backed planner ----------------------------------------------------
# With a key, prompts are planned by Claude (structured output → AppSpec) and
# materialised by the same builders as the deterministic planner, which stays
# as the fallback. Without a key the deterministic planner answers every prompt.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5
# low | medium | high | xhigh | max
PLANNER_EFFORT=medium
PLANNER_TIMEOUT_MS=45000

# --- Deployments -------------------------------------------------------------
# Where the Deploy button writes rendered sites and how they are reached.
# Unset: the API serves ./exports itself at http://localhost:4100/exports/.
# Fleet:  DEPLOY_EXPORT_ROOT=C:\inetpub\sites\studio\apps  DEPLOY_PUBLIC_BASE=https://studio.madproducts.ai/apps
DEPLOY_EXPORT_ROOT=
DEPLOY_PUBLIC_BASE=
