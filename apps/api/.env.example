# MAD Studio API
# Copy to .env and adjust. Every variable is validated at boot (src/config/env.ts).

NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:4200,https://studio.madproducts.ai

# Leave empty to run with the in-memory repository (schema-identical mirror of PostgreSQL).
DATABASE_URL=postgres://mad:mad@localhost:5432/mad_studio

# Multiplies every generation stream delay. 1 = designed pacing, 0 = instant (tests).
GENERATION_PACE=1

# Log level: debug | info | warn | error
LOG_LEVEL=info
