# MAD Studio deploy secrets - copy to deploy\.env.deploy (UNTRACKED, gitignored). Do NOT commit.

# PostgreSQL password for role `mad` on 127.0.0.1:5432/mad_studio. Alphanumeric, 16+ chars
# (it is embedded in DATABASE_URL without escaping).
MAD_STUDIO_DB_PASSWORD=CHANGE_ME

# Password for the seeded owner account (email below). 10+ chars. Re-deploying re-hashes it,
# so rotating the value here and running the deploy is enough to change it.
MAD_STUDIO_ADMIN_EMAIL=demo@madproducts.ai
MAD_STUDIO_ADMIN_PASSWORD=CHANGE_ME

# Optional. With a key the hosted API plans prompts with Claude (heuristic fallback stays on).
# Leave empty to run the deterministic planner only.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5
PLANNER_EFFORT=medium
