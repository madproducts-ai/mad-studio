# MAD Studio deploy secrets - copy to  deploy\.env.deploy  (untracked) and fill in real values.
# .env.deploy is gitignored; this .example is tracked as documentation (no real secrets).
#
# Password of the PostgreSQL role `mad` that owns database `mad_studio` on 127.0.0.1:5432.
# Rotate with:  ALTER ROLE mad PASSWORD '<new>';   then update this file and apps\api\.env.
MAD_STUDIO_DB_PASSWORD=CHANGE_ME
